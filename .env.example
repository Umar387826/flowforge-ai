# ==============================================================================
# FLOWFORGE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in secure values before starting services.
# Never commit .env to version control.
# ==============================================================================

# --- Django Core ---
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-50-plus-char-cryptographically-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Multi-Tenant Cryptographic Security ---
# Separate HMAC key used ONLY to sign/verify transaction-scoped PostgreSQL tenant tokens.
# Must be kept secret from the flowforge_app database role.
TENANT_SIGNING_KEY=replace-with-64-char-hex-hmac-signing-key
TENANT_TOKEN_TTL_SECONDS=30

# --- PostgreSQL + pgvector ---
# Runtime application role (non-superuser, subject to FORCE ROW LEVEL SECURITY)
POSTGRES_DB=flowforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_APP_USER=flowforge_app
POSTGRES_APP_PASSWORD=replace-with-strong-app-db-password
# Migration/owner role (used only during migrations and RLS policy setup)
POSTGRES_OWNER_USER=flowforge_owner
POSTGRES_OWNER_PASSWORD=replace-with-strong-owner-db-password

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/3

# --- AI Providers ---
# Anthropic Claude (Primary LLM for Agents, Tool Calling, Lead Qualification)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
# OpenAI (Embeddings: text-embedding-3-small 1536 dims, optional fallback LLM)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google OAuth 2.0 ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# --- HubSpot CRM ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/integrations/hubspot/callback
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Stripe Billing (Test Mode) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# --- Email & Notifications ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@flowforge.local

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=
